        <mxCell id="setup" value="Khởi tạo Serial, arduinoSerial.&lt;br&gt;Kết nối WiFi (chờ đến khi thành công).&lt;br&gt;Cấu hình MQTT server + đăng ký callback().&lt;br&gt;Khởi tạo bộ giải mã âm thanh I2S" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="130" width="360" height="110" as="geometry" /></mxCell>
